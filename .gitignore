# credentials never belong here — they live only on the control host
*.key
*.pem
*credentials*
*secret*
*token*
.env

# what a deployment calls itself, and which entry points it offers: both stay
# on the machines, only the examples are tracked
site.json
nodes.json

# machine defences and watchers are kept private, only on the machines
private/
sshd-hardening.conf
fail2ban-*.local
fleet.local
watch-peer
watch-peer.py

.venv/
.idea/
__pycache__/
*.pyc
