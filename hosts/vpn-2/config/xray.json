{
  "log": {
    "loglevel": "info"
  },
  "inbounds": [
    {
      "tag": "vless-reality",
      "listen": "192.0.2.10",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "<REDACTED-UUID>",
            "flow": "xtls-rprx-vision",
            "email": "probe"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "dest": "www.samsung.com:443",
          "serverNames": [
            "www.samsung.com"
          ],
          "privateKey": "<REDACTED>",
          "shortIds": [
            "<REDACTED>"
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "vless-ws",
      "listen": "127.0.0.1",
      "port": 8080,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "<REDACTED-UUID>",
            "email": "tunnel"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/assets"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    },
    {
      "tag": "vless-xhttp",
      "listen": "127.0.0.1",
      "port": 8082,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "<REDACTED-UUID>",
            "email": "xhttp"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "/xh",
          "mode": "packet-up"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ]
}